{
	"collection":"&Collection&",
	"query": [
		{"$match": {"$expr": {"$let": {"vars": {"a": "&AttributeName1&", "v1": {"$toInt": "&AttributeValue1&"}, "b": "&AttributeName2&", "v2": {"$toInt": "&AttributeValue2&"}}, "in": {"$and": [{"$eq": ["$$a", "$$v1"]}, {"$eq": ["$$b", "$$v2"]}]}}}}},
		{"$group": {"_id": {"attribute": "&AttributeReturn&", "label": "$label"}, "count": {"$sum": 1}}},
		{"$project": {"_id": 0, "attribute": "$_id.attribute", "label": "$_id.label", "count": 1}},
		{"$sort": {"attribute": 1, "label": 1}}
	]
}
