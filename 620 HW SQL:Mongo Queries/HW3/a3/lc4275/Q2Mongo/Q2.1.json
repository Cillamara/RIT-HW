{
    "collection": "Users",
    "query": [
        {"$match": {"$expr": {"$and": [{"$gte": ["$yelping_since", {"$toDate": "&init_date&"}]}, {"$lte": ["$yelping_since", {"$toDate": "&end_date&"}]}]}}},
        {"$addFields": {"funny_d": {"$toDecimal": "$funny"}}},
        {"$setWindowFields": {
            "output": {
                "min_funny": {"$min": "$funny_d", "window": {"documents": ["unbounded", "unbounded"]}},
                "max_funny": {"$max": "$funny_d", "window": {"documents": ["unbounded", "unbounded"]}}
            }
        }},
        {"$project": {
            "_id": 1,
            "scaled_funny": {"$divide": [
                {"$subtract": ["$funny_d", "$min_funny"]},
                {"$subtract": ["$max_funny", "$min_funny"]}
            ]}
        }},
        {"$sort": {"scaled_funny": -1, "_id": 1}}
    ]
}
