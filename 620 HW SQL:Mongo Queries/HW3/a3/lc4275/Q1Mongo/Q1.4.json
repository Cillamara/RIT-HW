{
    "collection": "Businesses",
    "query": [
        {"$unwind": "$categories"},
        {"$match": {"categories": "&category&", "restaurants_price_range": {"$exists": true, "$ne": null}}},
        {"$group": {"_id": "$restaurants_price_range", "count": {"$sum": 1}}},
        {"$sort": {"count": -1}},
        {"$limit": 1},
        {"$project": {"_id": 0, "mode": {"$toInt": "$_id"}}}
    ]
}
