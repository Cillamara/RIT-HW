{
	"collection": "&LCollection&",
	"query": [
		{"$lookup": {
			"from": "&LCollection&",
			"let": {"iid1": "$iid_1", "iid2": "$iid_2", "iid3": "$iid_3"},
			"pipeline": [
				{"$match": {"$expr": {"$and": [
					{"$eq": ["$iid_1", "$$iid1"]},
					{"$eq": ["$iid_2", "$$iid2"]},
					{"$gt": ["$iid_3", "$$iid3"]}
				]}}}
			],
			"as": "matches"
		}},
		{"$unwind": "$matches"},
		{"$project": {"_id": 0, "iid_1": 1, "iid_2": 1, "iid_3": 1, "iid_4": "$matches.iid_3"}},
		{"$sort": {"iid_1": 1, "iid_2": 1, "iid_3": 1, "iid_4": 1}}
	]
}
