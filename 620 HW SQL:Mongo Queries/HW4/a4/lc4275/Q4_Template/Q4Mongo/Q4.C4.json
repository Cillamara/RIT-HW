{
	"collection": "&CCollection&",
	"query": [
		{"$lookup": {
			"from": "&LCollection&",
			"let": {"i1": "$iid_1", "i3": "$iid_3", "i4": "$iid_4"},
			"pipeline": [
				{"$match": {"$expr": {"$and": [
					{"$eq": ["$iid_1", "$$i1"]},
					{"$eq": ["$iid_2", "$$i3"]},
					{"$eq": ["$iid_3", "$$i4"]}
				]}}}
			],
			"as": "check1"
		}},
		{"$match": {"check1.0": {"$exists": true}}},
		{"$lookup": {
			"from": "&LCollection&",
			"let": {"i2": "$iid_2", "i3": "$iid_3", "i4": "$iid_4"},
			"pipeline": [
				{"$match": {"$expr": {"$and": [
					{"$eq": ["$iid_1", "$$i2"]},
					{"$eq": ["$iid_2", "$$i3"]},
					{"$eq": ["$iid_3", "$$i4"]}
				]}}}
			],
			"as": "check2"
		}},
		{"$match": {"check2.0": {"$exists": true}}},
		{"$project": {"_id": 0, "iid_1": 1, "iid_2": 1, "iid_3": 1, "iid_4": 1}},
		{"$sort": {"iid_1": 1, "iid_2": 1, "iid_3": 1, "iid_4": 1}}
	]
}
