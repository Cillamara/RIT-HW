{
	"collection": "&Collection&",
	"query": [
		{"$setWindowFields": {"output": {
			"_avg1": {"$avg": "$dim_1"}, "_avgsq1": {"$avg": {"$pow": ["$dim_1", 2]}},
			"_avg2": {"$avg": "$dim_2"}, "_avgsq2": {"$avg": {"$pow": ["$dim_2", 2]}},
			"_avg3": {"$avg": "$dim_3"}, "_avgsq3": {"$avg": {"$pow": ["$dim_3", 2]}},
			"_avg4": {"$avg": "$dim_4"}, "_avgsq4": {"$avg": {"$pow": ["$dim_4", 2]}},
			"_avg5": {"$avg": "$dim_5"}, "_avgsq5": {"$avg": {"$pow": ["$dim_5", 2]}},
			"_avg6": {"$avg": "$dim_6"}, "_avgsq6": {"$avg": {"$pow": ["$dim_6", 2]}},
			"_avg7": {"$avg": "$dim_7"}, "_avgsq7": {"$avg": {"$pow": ["$dim_7", 2]}}
		}}},
		{"$addFields": {
			"_sd1": {"$sqrt": {"$subtract": ["$_avgsq1", {"$pow": ["$_avg1", 2]}]}},
			"_sd2": {"$sqrt": {"$subtract": ["$_avgsq2", {"$pow": ["$_avg2", 2]}]}},
			"_sd3": {"$sqrt": {"$subtract": ["$_avgsq3", {"$pow": ["$_avg3", 2]}]}},
			"_sd4": {"$sqrt": {"$subtract": ["$_avgsq4", {"$pow": ["$_avg4", 2]}]}},
			"_sd5": {"$sqrt": {"$subtract": ["$_avgsq5", {"$pow": ["$_avg5", 2]}]}},
			"_sd6": {"$sqrt": {"$subtract": ["$_avgsq6", {"$pow": ["$_avg6", 2]}]}},
			"_sd7": {"$sqrt": {"$subtract": ["$_avgsq7", {"$pow": ["$_avg7", 2]}]}}
		}},
		{"$project": {
			"_id": 1,
			"scaled_dim_1": {"$cond": [{"$or": [{"$eq": ["$_sd1", 0]}, {"$eq": ["$_sd1", null]}]}, {"$toDecimal": 0}, {"$divide": [{"$subtract": ["$dim_1", "$_avg1"]}, "$_sd1"]}]},
			"scaled_dim_2": {"$cond": [{"$or": [{"$eq": ["$_sd2", 0]}, {"$eq": ["$_sd2", null]}]}, {"$toDecimal": 0}, {"$divide": [{"$subtract": ["$dim_2", "$_avg2"]}, "$_sd2"]}]},
			"scaled_dim_3": {"$cond": [{"$or": [{"$eq": ["$_sd3", 0]}, {"$eq": ["$_sd3", null]}]}, {"$toDecimal": 0}, {"$divide": [{"$subtract": ["$dim_3", "$_avg3"]}, "$_sd3"]}]},
			"scaled_dim_4": {"$cond": [{"$or": [{"$eq": ["$_sd4", 0]}, {"$eq": ["$_sd4", null]}]}, {"$toDecimal": 0}, {"$divide": [{"$subtract": ["$dim_4", "$_avg4"]}, "$_sd4"]}]},
			"scaled_dim_5": {"$cond": [{"$or": [{"$eq": ["$_sd5", 0]}, {"$eq": ["$_sd5", null]}]}, {"$toDecimal": 0}, {"$divide": [{"$subtract": ["$dim_5", "$_avg5"]}, "$_sd5"]}]},
			"scaled_dim_6": {"$cond": [{"$or": [{"$eq": ["$_sd6", 0]}, {"$eq": ["$_sd6", null]}]}, {"$toDecimal": 0}, {"$divide": [{"$subtract": ["$dim_6", "$_avg6"]}, "$_sd6"]}]},
			"scaled_dim_7": {"$cond": [{"$or": [{"$eq": ["$_sd7", 0]}, {"$eq": ["$_sd7", null]}]}, {"$toDecimal": 0}, {"$divide": [{"$subtract": ["$dim_7", "$_avg7"]}, "$_sd7"]}]}
		}},
		{"$sort": {"_id": 1}}
	]
}
